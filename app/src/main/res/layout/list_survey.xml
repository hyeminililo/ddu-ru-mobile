<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <Button
            android:id="@+id/btnSightseeing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnExhibition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnNature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnFoodTour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnShopping"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnRelaxation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnAmusementPark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnFestival"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/option"
            android:textSize="14sp"
            android:backgroundTint="#FFA100"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="4dp" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>